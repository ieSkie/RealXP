generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  stats        UserStat[]
  habits       Habit[]
  tasks        Task[]
  achievements UserAchievement[]
}

model Stat {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?

  userStats    UserStat[]
  habits       Habit[]
  tasks        Task[]
}

model UserStat {
  id           String @id @default(uuid())
  userId       String
  statId       String
  totalActions Int    @default(0)

  user User @relation(fields: [userId], references: [id])
  stat Stat @relation(fields: [statId], references: [id])

  @@unique([userId, statId])
}

model Habit {
  id            String   @id @default(uuid())
  userId        String
  statId        String
  title         String
  description   String?
  targetPerWeek Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User      @relation(fields: [userId], references: [id])
  stat Stat      @relation(fields: [statId], references: [id])
  logs HabitLog[]

  userAchievements UserAchievement[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  statId      String
  title       String
  description String?
  deadline    DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  stat Stat @relation(fields: [statId], references: [id])
}

model Achievement {
  id          String @id @default(uuid())
  title       String
  description String?
  threshold   Int

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  habitId       String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])
  habit       Habit       @relation(fields: [habitId], references: [id])
}